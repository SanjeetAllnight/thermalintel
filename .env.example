# ==============================================================================
# ThermalIntel V2 Configuration Template (.env.example)
# ==============================================================================
# Copy this template to .env for local development or container deployment:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit real credentials or .env files to version control.
# - All keys below are safe templates. Distinctions between REQUIRED and OPTIONAL
#   values are explicitly documented in each section.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operational Mode (REQUIRED)
# ------------------------------------------------------------------------------
# 'demo': Operates completely offline with 100% deterministic seed datasets in data/sample/.
#         No external network calls or API keys are required. Recommended for CI, evaluation,
#         and quickstart testing.
# 'live': Operates against live upstream telemetry feeds (NASA FIRMS, OSM Overpass, Open-Meteo).
DATA_MODE=demo

# ------------------------------------------------------------------------------
# 2. Observability & Logging Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Environment name: 'development', 'staging', 'production', or 'test'
ENVIRONMENT=development

# Service identity for structured log events and metrics
SERVICE_NAME=thermalintel-backend

# Log formatting:
# 'text': Colorized, human-readable terminal format (recommended for local development).
# 'json': Machine-readable, single-line JSON with UTC ISO-8601 timestamps and correlation IDs
#         (automatically selected in production containers and CI).
LOG_FORMAT=text

# Log verbosity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. NASA FIRMS API Credentials (OPTIONAL in 'demo' mode; REQUIRED for 'live' mode)
# ------------------------------------------------------------------------------
# Free 32-character hex map key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty and DATA_MODE=live, system gracefully falls back to local curated sample data.
FIRMS_MAP_KEY=

# Ingestion query defaults
FIRMS_DEFAULT_SOURCE=VIIRS_SNPP_NRT
FIRMS_DEFAULT_AREA=USA_contiguous_and_Hawaii
FIRMS_DEFAULT_DAYS=1
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 4. Geospatial & Weather APIs (OPTIONAL - Free public endpoints, no key required)
# ------------------------------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 5. Storage, Database & Cache Persistence (REQUIRED)
# ------------------------------------------------------------------------------
# SQLite file path. In Docker, mount this on a persistent volume (e.g. /app/data/thermalintel.db)
DATABASE_PATH=thermalintel.db

# Directory for caching Overpass OSM and Open-Meteo weather JSON responses
CACHE_DIR=data/cache

# Ephemeral cache expiration TTL in seconds (default 1 hour)
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 6. Backend Server & Security Configuration (REQUIRED)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security: CORS Allowed Origins (Comma-separated list; wildcards '*' are disallowed)
# In production, set to your specific frontend URL(s), e.g. https://thermalintel.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security: Mutation Endpoint Protection (e.g. POST /api/refresh)
# Leave empty for open access during local development and automated demo testing.
# Set a strong 32+ char secret in production to require 'X-API-Key: <key>' header.
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 7. Frontend Command Center Configuration (REQUIRED for web client)
# ------------------------------------------------------------------------------
# API base URL consumed by the Next.js client
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Internal backend URL used by Next.js server rewrites in Docker container networks
BACKEND_INTERNAL_URL=http://backend:8000/api/:path*

# CARTO Basemap API Key (OPTIONAL)
# If empty, keyless public CARTO basemap tiles with standard attribution are used
NEXT_PUBLIC_CARTO_API_KEY=
