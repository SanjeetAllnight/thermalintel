# ==========================================================
# ThermalIntel Configuration Template (.env.example)
# Copy to .env for local development
# NEVER commit .env containing real credentials to version control
# ==========================================================

# NASA FIRMS API Credentials
# Get your free Map Key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left empty, system operates in high-fidelity DEMO fallback mode
FIRMS_MAP_KEY=
FIRMS_DEFAULT_SOURCE=VIIRS_SNPP_NRT
FIRMS_DEFAULT_AREA=USA_contiguous_and_Hawaii
FIRMS_DEFAULT_DAYS=1
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_TIMEOUT_SECONDS=10.0

# Geospatial & Weather APIs (Free public APIs, no API key required)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Storage & Persistence
DATABASE_PATH=thermalintel.db
CACHE_DIR=data/cache
CACHE_TTL_SECONDS=3600

# Operational Mode: 'live' or 'demo'
DATA_MODE=demo

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security: CORS Allowed Origins (Comma-separated list; no wildcards allowed)
# In production, set to your frontend domain(s), e.g. https://thermalintel.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security: Mutation Endpoint Protection (e.g. POST /api/refresh)
# Leave empty for open access during local development and demo testing.
# Set a strong secret token in production to require 'X-API-Key: <key>' header.
ADMIN_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# CARTO Basemap API Key (Optional)
# If empty, keyless CARTO basemap tiles with standard attribution are used
NEXT_PUBLIC_CARTO_API_KEY=
