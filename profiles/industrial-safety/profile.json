{
  "metadata": {
    "id": "industrial-safety",
    "display_name": "Industrial & Petrochemical Safety",
    "description": "Operational intelligence profile for monitoring petrochemical refineries, continuous flare systems, unit overheating, and chemical plant safety perimeters.",
    "version": "1.0.0",
    "author": "ThermalIntel Industrial Solutions",
    "tags": ["industrial", "petrochemical", "refinery", "flare-monitoring", "safety"]
  },
  "providers": {
    "enabled_providers": ["NASA_FIRMS", "OPEN_METEO", "LOCAL_IR_TELEMETRY"],
    "default_source": "VIIRS_SNPP_NRT",
    "supported_products": ["VIIRS_SNPP_NRT", "MODIS_NRT"],
    "provider_settings": {
      "cache_ttl_seconds": 1800,
      "timeout_seconds": 5.0
    }
  },
  "taxonomy": {
    "supported_classes": [
      "POTENTIAL_INDUSTRIAL_FIRE",
      "PERSISTENT_THERMAL_SOURCE",
      "CONTROLLED_HEAT_SOURCE",
      "VEGETATION_FIRE",
      "UNKNOWN"
    ],
    "default_class": "UNKNOWN",
    "class_to_source_type": {
      "POTENTIAL_INDUSTRIAL_FIRE": "industrial",
      "PERSISTENT_THERMAL_SOURCE": "industrial",
      "CONTROLLED_HEAT_SOURCE": "prescribed_burn",
      "VEGETATION_FIRE": "wildfire",
      "UNKNOWN": "unknown"
    },
    "source_type_to_class": {
      "industrial": "POTENTIAL_INDUSTRIAL_FIRE",
      "wildfire": "VEGETATION_FIRE",
      "prescribed_burn": "CONTROLLED_HEAT_SOURCE",
      "agricultural": "CONTROLLED_HEAT_SOURCE",
      "urban": "UNKNOWN",
      "volcanic": "UNKNOWN",
      "unknown": "UNKNOWN"
    },
    "incompatible_incident_pairs": [
      ["industrial", "wildfire"],
      ["volcanic", "industrial"]
    ]
  },
  "rules": {
    "evidence_priors": {
      "POTENTIAL_INDUSTRIAL_FIRE": 0.20,
      "PERSISTENT_THERMAL_SOURCE": 0.20,
      "CONTROLLED_HEAT_SOURCE": 0.10,
      "VEGETATION_FIRE": 0.05,
      "UNKNOWN": 0.15
    },
    "thresholds": {
      "frp_high_mw": 25.0,
      "frp_extreme_mw": 50.0,
      "frp_moderate_mw": 12.0,
      "frp_low_mw": 5.0,
      "recurrent_min_passes_30d": 10,
      "persistence_score_threshold": 0.40,
      "wind_high_kmh": 25.0,
      "rh_critical_pct": 30.0,
      "industrial_immediate_m": 300.0,
      "industrial_vicinity_m": 1200.0
    },
    "rule_identifiers": {
      "POTENTIAL_INDUSTRIAL_FIRE": "RULE_INDUSTRIAL_HAZARD_SPIKE",
      "PERSISTENT_THERMAL_SOURCE": "RULE_PERSISTENT_INDUSTRIAL_EMITTER",
      "CONTROLLED_HEAT_SOURCE": "RULE_ROUTINE_PROCESS_FLARING",
      "VEGETATION_FIRE": "RULE_PERIMETER_BRUSH_EXPOSURE",
      "UNKNOWN": "RULE_AMBIGUOUS_UNRESOLVED_UNKNOWN"
    }
  },
  "risk": {
    "weights": {
      "frp": 0.40,
      "weather": 0.15,
      "proximity": 0.25,
      "anomaly": 0.10,
      "history": 0.10
    },
    "thresholds": {
      "critical": 70.0,
      "high": 45.0,
      "medium": 20.0,
      "low": 0.0
    },
    "source_modulations": {
      "prescribed_burn": 0.50,
      "agricultural": 0.60
    },
    "settlement_distance_critical_m": 500.0,
    "infra_distance_critical_m": 250.0
  },
  "incidents": {
    "spatial_threshold_km": 0.6,
    "temporal_window_hours": 12.0,
    "merge_distance_km": 1.0,
    "reopen_window_hours": 24.0,
    "incompatible_pairs": [
      ["industrial", "wildfire"],
      ["volcanic", "industrial"]
    ]
  },
  "alerts": {
    "enabled_rules": [
      "RULE_NEW_INCIDENT",
      "RULE_INCIDENT_ESCALATED",
      "RULE_INCIDENT_DEESCALATED",
      "RULE_INCIDENT_REOPENED",
      "RULE_INCIDENT_CLOSED",
      "RULE_EXTREME_FRP"
    ],
    "extreme_frp_threshold": 40.0,
    "flood_protection": {
      "per_rule_cooldown_seconds": 300,
      "per_incident_cooldown_seconds": 60,
      "max_alerts_per_window": 8,
      "window_seconds": 1800
    },
    "alertable_severities": ["critical", "high"]
  },
  "assets": {
    "asset_categories": ["industrial", "infrastructure", "settlement"],
    "static_assets_path": "profiles/industrial-safety/assets/industrial_assets.geojson",
    "proximity_priority": "facility"
  },
  "scenarios": {
    "scenario_ids": [
      "SCN-001-INDUSTRIAL-SPIKE"
    ],
    "default_scenario_id": "SCN-001-INDUSTRIAL-SPIKE"
  }
}
